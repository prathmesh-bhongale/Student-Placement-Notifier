NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB (drives + admins)
MONGODB_URI=mongodb://127.0.0.1:27017/placementNotifierDB

# MySQL (students) - the database is created automatically if missing
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=student_placement

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Default admin (auto-created on first start)
ADMIN_NAME=TPO Admin
ADMIN_EMAIL=admin@placement.com
ADMIN_PASSWORD=Admin@123

# Rate limit for auth endpoints (per 15 minutes per IP)
AUTH_RATE_LIMIT=100

# Email (optional). If EMAIL_USER is empty, emails are printed to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Placement Cell <noreply@placement.com>
